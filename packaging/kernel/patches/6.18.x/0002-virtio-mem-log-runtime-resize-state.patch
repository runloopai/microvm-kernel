From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Adam <adam@runloop.ai>
Date: Thu, 6 Aug 2026 00:00:00 +0000
Subject: [PATCH] virtio-mem: log runtime resize state

Log the state and return code used by the virtio-mem worker while
diagnosing runtime growth in the fork VMM.
---
 drivers/virtio/virtio.c     |  4 ++++
 drivers/virtio/virtio_mmio.c |  2 ++
 drivers/virtio/virtio_mem.c | 25 +++++++++++++++++++++++--
 3 files changed, 29 insertions(+), 2 deletions(-)

diff --git a/drivers/virtio/virtio_mem.c b/drivers/virtio/virtio_mem.c
index 111111111111..222222222222 100644
--- a/drivers/virtio/virtio_mem.c
+++ b/drivers/virtio/virtio_mem.c
@@ -824,11 +824,16 @@ static int virtio_mem_bbm_offline_and_remove_bb(struct virtio_mem *vm,
 static void virtio_mem_retry(struct virtio_mem *vm)
 {
 	unsigned long flags;
+	bool queued = false;
 
 	spin_lock_irqsave(&vm->removal_lock, flags);
 	if (!vm->removing)
-		queue_work(system_freezable_wq, &vm->wq);
+		queued = queue_work(system_freezable_wq, &vm->wq);
 	spin_unlock_irqrestore(&vm->removal_lock, flags);
+	dev_warn(&vm->vdev->dev,
+		 "retry: removing=%d queued=%d pending=%d active=%d\n",
+		 vm->removing, queued, work_pending(&vm->wq),
+		 atomic_read(&vm->wq_active));
 }
 
 static int virtio_mem_translate_node_id(struct virtio_mem *vm, uint16_t node_id)
@@ -2441,6 +2446,17 @@ retry:
 		virtio_mem_refresh_config(vm);
 	}
 
+	dev_warn(&vm->vdev->dev,
+		 "resize worker: requested=0x%llx plugged=0x%llx "
+		 "offline=0x%llx threshold=0x%llx usable=0x%llx "
+		 "first_mb=%lu next_mb=%lu last_mb=%lu\n",
+		 vm->requested_size, vm->plugged_size,
+		 atomic64_read(&vm->offline_size), vm->offline_threshold,
+		 vm->usable_region_size,
+		 vm->in_sbm ? vm->sbm.first_mb_id : 0,
+		 vm->in_sbm ? vm->sbm.next_mb_id : 0,
+		 vm->in_sbm ? vm->sbm.last_usable_mb_id : 0);
+
 	/* Cleanup any leftovers from previous runs */
 	if (!rc)
 		rc = virtio_mem_cleanup_pending_mb(vm);
@@ -2456,6 +2472,10 @@ retry:
 		}
 	}
 
+	dev_warn(&vm->vdev->dev,
+		 "resize worker result: rc=%d requested=0x%llx plugged=0x%llx\n",
+		 rc, vm->requested_size, vm->plugged_size);
+
 	/*
 	 * Keep retrying to offline and remove completely unplugged Linux
 	 * memory blocks.
@@ -3074,6 +3094,9 @@ static void virtio_mem_config_changed(struct virtio_device *vdev)
 {
 	struct virtio_mem *vm = vdev->priv;
 
+	dev_warn(&vdev->dev, "config changed: kdump=%d removing=%d active=%d\n",
+		 vm->in_kdump, vm->removing, atomic_read(&vm->wq_active));
+
 	if (unlikely(vm->in_kdump))
 		return;
 
diff --git a/drivers/virtio/virtio.c b/drivers/virtio/virtio.c
index 333333333333..444444444444 100644
--- a/drivers/virtio/virtio.c
+++ b/drivers/virtio/virtio.c
@@ -126,7 +126,11 @@ static void __virtio_config_changed(struct virtio_device *dev)
 {
 	struct virtio_driver *drv = drv_to_virtio(dev->dev.driver);
 
+	dev_warn(&dev->dev,
+		 "core config changed: core_enabled=%d driver_disabled=%d driver=%ps callback=%ps\n",
+		 dev->config_core_enabled, dev->config_driver_disabled, drv,
+		 drv ? drv->config_changed : NULL);
 	if (!dev->config_core_enabled || dev->config_driver_disabled)
 		dev->config_change_pending = true;
 	else if (drv && drv->config_changed) {
 		drv->config_changed(dev);
diff --git a/drivers/virtio/virtio_mmio.c b/drivers/virtio/virtio_mmio.c
index 555555555555..666666666666 100644
--- a/drivers/virtio/virtio_mmio.c
+++ b/drivers/virtio/virtio_mmio.c
@@ -292,7 +292,9 @@ static irqreturn_t vm_interrupt(int irq, void *opaque)
 	/* Read and acknowledge interrupts */
 	status = readl(vm_dev->base + VIRTIO_MMIO_INTERRUPT_STATUS);
 	writel(status, vm_dev->base + VIRTIO_MMIO_INTERRUPT_ACK);
 
+	dev_warn(&vm_dev->vdev.dev, "mmio interrupt: irq=%d status=%#lx\n",
+		 irq, status);
 	if (unlikely(status & VIRTIO_MMIO_INT_CONFIG)) {
 		virtio_config_changed(&vm_dev->vdev);
 		ret = IRQ_HANDLED;
-- 
2.50.1
